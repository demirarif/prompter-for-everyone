{
  "name": "prompter-for-everyone",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first, open-source browser teleprompter with camera recording. No accounts, backend, or API keys.",
  "type": "module",
  "license": "MIT",
  "author": "Arif Demir",
  "repository": { "type": "git", "url": "https://github.com/demirarif/prompter-for-everyone.git" },
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": { "react": "19.2.6", "react-dom": "19.2.6" },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "keywords": ["teleprompter", "autocue", "camera", "video-recording", "local-first", "react", "typescript", "iphone", "open-source"]
}
